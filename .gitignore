# Whitelist: this repo lives directly in ~/.config, so ignore everything
# that is not an explicitly tracked dotfile directory/file.
/*
!.gitignore
!README.md
!flake.nix
!flake.lock
!.zed/
!fish/
!fixes/
!kitty/
!mango/
!nix/
!omarchy/
!yazi/
!zed/

# Rewritten by fish at runtime, and machine-specific
fish/fish_variables

# Generated by Noctalia
mango/noctalia.conf

# Omarchy: only personal changes, not its pre-made config
omarchy/*
!omarchy/README.md
!omarchy/install.bash
!omarchy/plugins/
!omarchy/shell/
!omarchy/apps/
!omarchy/hypr/
omarchy/hypr/*
!omarchy/hypr/custom.lua
!omarchy/hypr/monitor-workspaces.lua
!omarchy/hypr/solo-workspaces.lua
