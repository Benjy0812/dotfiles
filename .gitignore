# Whitelist: this repo lives directly in ~/.config, so ignore everything
# that is not an explicitly tracked dotfile directory/file.
/*
!.gitignore
!README.md
!flake.nix
!flake.lock
!.zed/
!fish/
!fixes/
!kitty/
!mango/
!nix/
!omarchy/
!yazi/
!zed/

# Generated by Noctalia
mango/noctalia.conf

# Omarchy: track only custom plugins, not its pre-made config
omarchy/*
!omarchy/plugins/
