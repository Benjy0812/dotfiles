# Whitelist: ignore everything that is not an explicitly tracked dotfile
# directory/file, so machine-specific or private configs never sneak in.
/*
!.gitignore
!apps/
!README.md
!dotfiles.bash
!.dotfilesignore
!.dotfiles-hosts
!.dotfiles-map
!flake.nix
!flake.lock
!fixes/
!mango/
!profiles/
!nix/

# Rewritten by fish at runtime, and machine-specific
apps/fish/fish_variables

# Generated by Noctalia
mango/noctalia.conf

# Machine-specific files that must not be committed from any profile
profiles/*/fish/fish_variables
profiles/*/mango/noctalia.conf

# Per-machine list of files dotfiles.bash skips
.dotfilesignore
