# Whitelist: ignore everything that is not an explicitly tracked dotfile
# directory/file, so machine-specific or private configs never sneak in.
/*
!.gitignore
!apps/
!README.md
!dotfiles.bash
!.dotfilesignore
!.dotfiles-hosts
!flake.nix
!flake.lock
!fixes/
!mango/
!nix/
!omarchy/

# Rewritten by fish at runtime, and machine-specific
apps/fish/fish_variables

# Generated by Noctalia
mango/noctalia.conf

# Omarchy: only personal changes, not its pre-made config
omarchy/*
!omarchy/README.md
!omarchy/install.bash
!omarchy/plugins/
!omarchy/shell/
!omarchy/hypr/
omarchy/hypr/*
!omarchy/hypr/custom.lua
!omarchy/hypr/monitor-workspaces.lua
!omarchy/hypr/solo-workspaces.lua
